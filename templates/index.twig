{% block content %}
<div class="simpleABTestingPlugin">
<h1>Simple A/B Testing</h1>
{% if message is not empty %}
<div class="alert">
    {{ message }}
</div>
{% endif %}

    <div class="card">
        <div class="card-content">
            <h2>Create a new experiment</h2>

            <form method="post" action="{{ actionUrl }}">
                <input type="hidden" name="redirect_url" value="{{ currentUrl }}">
                <input type="hidden" name="nonce" value="{{ nonce }}" >

                <h3 class="form-section-title">Basic info</h3>
                <div class="row">
                    <div class="col s12 m6 form-field">
                        <label for="name">Experiment Name</label>
                        <input type="text" name="name" id="name" required>
                        <span class="form-hint">Only alphanumeric characters, no spaces &mdash; always use a new name to avoid cookie conflicts.</span>
                    </div>
                    <div class="col s12 m6 form-field">
                        <label for="hypothesis">Hypothesis</label>
                        <input type="text" name="hypothesis" id="hypothesis">
                    </div>
                </div>
                <div class="row">
                    <div class="col s12 m6 form-field">
                        <label for="description">Description</label>
                        <input type="text" name="description" id="description">
                    </div>
                </div>

                <h3 class="form-section-title">Schedule</h3>
                <div class="row">
                    <div class="col s12 m6 form-field">
                        <label for="from_date">From Date</label>
                        <input type="date" name="from_date" id="from_date" value="{{ formattedToday }}" required>
                        <span class="form-hint">Starts at 00:00 UTC.</span>
                    </div>
                    <div class="col s12 m6 form-field">
                        <label for="to_date">To Date</label>
                        <input type="date" name="to_date" id="to_date" value="{{ formattedOneMonthLater }}" required>
                        <span class="form-hint">Ends at 23:59 UTC.</span>
                    </div>
                </div>

                <h3 class="form-section-title">Variant code</h3>
                <div class="row">
                    <div class="col s12 code-field">
                        <label for="css_insert">CSS insert (variant 1)</label>
                        <textarea name="css_insert" id="css_insert" class="code-textarea"></textarea>
                        <span class="form-hint">Example: .h1 { display: none } &mdash; the example code removes the h1 tag.</span>
                    </div>
                </div>
                <div class="row">
                    <div class="col s12 code-field">
                        <label for="js_insert">Custom JS (variant 1)</label>
                        <textarea name="js_insert" id="js_insert" class="code-textarea"></textarea>
                        <span class="form-hint">Example code removes the h1 tag.</span>
                    </div>
                </div>

                <div class="form-actions">
                    <input type="submit" value="Add Experiment" class="btn">
                </div>
            </form>
        </div>
    </div>
</div>
{% endblock %}
